# Local configuration for the documentation site. Copy to `.env.local`, which is
# gitignored, and fill in. Then run:
#
#     python scripts/configure_site.py
#
# which writes `docs/_data/posthog.yml` for Jekyll to read. Deleting `.env.local`
# and running it again turns analytics back off.
#
# The deployed site does not use this file - GitHub Pages builds on GitHub's own
# machines, where the same value comes from the `POSTHOG_KEY` repository secret
# (Settings -> Secrets and variables -> Actions). Set it in both places, or the
# live site measures nothing.

# The documentation site's own PostHog project - not nika-site's, and not the one
# the OnlyMap runtime reports exported-map usage to. Project settings -> Project
# API key, starts with `phc_`.
#
# This key is write-only and is published in the page source of every page on the
# site. It is not a secret. The personal API key that *reads* analytics data is a
# real secret and must never be put here.
POSTHOG_KEY=

# US or EU cloud, matching where the project was created. Defaults to US.
POSTHOG_HOST=https://us.i.posthog.com
