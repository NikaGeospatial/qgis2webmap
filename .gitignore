# Build output
dist/
build/
*.zip

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.orig
*.rej

# Compiled Qt resources are generated, not committed
nika_onlymap_exporter/resources_rc.py

# QGIS scratch databases. The style manager and the form designer drop these in
# whatever directory QGIS was launched from, which during development is this
# repository root. Two were committed before this rule existed.
*.db
*.db-journal
*.gpkg-journal

# The OnlyMap runtime, when a contributor symlinks or copies a build in to work
# against it. The vendored copy that ships is added deliberately, not by glob.
nika_onlymap_exporter/runtime/*.js
nika_onlymap_exporter/runtime/*.css

# Local design and launch working files (logo explorations, distribution
# planning). Scratch only - nothing in here ships.
/scratch/
