# Build output
dist/
build/
*.zip

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.orig
*.rej

# Compiled Qt resources are generated, not committed
nika_onlymap_exporter/resources_rc.py

# QGIS scratch databases. The style manager and the form designer drop these in
# whatever directory QGIS was launched from, which during development is this
# repository root. Two were committed before this rule existed.
*.db
*.db-journal
*.gpkg-journal

# The OnlyMap runtime, when a contributor symlinks or copies a build in to work
# against it. The vendored copy that ships is added deliberately, not by glob.
nika_onlymap_exporter/runtime/*.js
nika_onlymap_exporter/runtime/*.css

# Local design and launch working files (logo explorations, distribution
# planning). Scratch only - nothing in here ships.
/scratch/

# The Jekyll data file written by `scripts/configure_site.py` during the Pages
# build. Holds the documentation site's PostHog project key, which comes from the
# POSTHOG_KEY repository secret and is configured nowhere else. That key is
# write-only and is published in the page source anyway, so this is not
# protecting a secret - it keeps the key out of the repository so secret scanners
# stay quiet during plugin-repository review and so it can be rotated without a
# commit.
/docs/_data/posthog.yml

# Nothing reads a dotenv file here - the environment variable is the only input.
# Ignored anyway, so that a stray one someone creates out of habit cannot be
# committed with a key in it.
/.env.local

# Jekyll's build output, written whenever the docs site is served locally. The
# published site is built by the Pages workflow from the sources, never from a
# committed copy of this directory.
/docs/_site/
